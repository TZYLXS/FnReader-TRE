#!/bin/sh /etc/rc.common
# FnReader 软总线解析引擎 —— procd 服务
START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/fnparse
CONF=/etc/config/fnparse

start_service() {
	config_load fnparse
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || {
		logger -t fnparse "disabled by uci (enabled=0)"
		return 0
	}
	[ -x "$PROG" ] || return 0

	procd_open_instance fnparse
	procd_set_param command "$PROG" run -c "$CONF"
	# 崩溃后 5 秒拉起，最多 5 次/小时
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096"
	procd_set_param nice -5
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "fnparse"
}
