#!/bin/sh
# 首次安装：修可执行位、注册开机启动
chmod 755 /usr/bin/fnparse /etc/init.d/fnparse /usr/libexec/rpcd/fnparse 2>/dev/null
if [ -x /etc/init.d/fnparse ]; then
	/etc/init.d/fnparse enable 2>/dev/null
fi
# 0.2 → 0.3：插件定位改为「只承接媒体类（cover/intro/bookinfo）」，领取类型写死。
# 旧配置若含 ebook 类任务类型，一律改为媒体三类；引擎侧会忽略其它取值。
t=$(uci -q get fnparse.main.claim_types 2>/dev/null)
case ",$t," in
  *,ebook-parse,*|*,ebook-chapter,*)
	uci set fnparse.main.claim_types='cover,intro,bookinfo'
	uci commit fnparse
	;;
esac
# 0.2 的 concurrency 已废弃（引擎写死单线程），清理避免误导
if uci -q get fnparse.main.concurrency >/dev/null 2>&1; then
	uci -q delete fnparse.main.concurrency
	uci commit fnparse
fi
exit 0
